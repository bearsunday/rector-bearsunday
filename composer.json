{
    "name": "bearsunday/rector-bearsunday",
    "type": "rector-extension",
    "license": "MIT",
    "description": "Rector upgrades rules for BEAR.Sunday Framework",
    "require": {
        "php": "^8.1",
        "rector/rector": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Utils\\Rector\\": "utils/rector/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utils\\Rector\\Tests\\": "utils/rector/tests"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "ray/query-module": "^1.x-dev",
        "doctrine/coding-standard": "^12.0"
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": ["./vendor/bin/phpcbf --standard=./phpcs.xml utils/rector/src"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
